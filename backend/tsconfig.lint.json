{
  /*
   * Type-aware linting needs the tests in a project, and the BUILD must not
   * compile them into dist. So the build config stays narrow and this one
   * widens it for tooling only. Nothing emits from here.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "prisma/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
