# ---------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database ------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_rental_dev?schema=public"

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed browser origins (customer site + admin site)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Auth (used from Phase 2 onwards) ------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Brute-force protection ---------------------------------------------
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Refresh-token cookie ------------------------------------------------
# COOKIE_SECURE must be true in production (HTTPS only).
# SameSite is site-based, not origin-based: the port is not part of a "site",
# so 'lax' works for localhost:5173 -> localhost:4000 and for
# app.example.com -> api.example.com. Use 'none' (with secure=true) only for a
# genuinely cross-site deployment.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- First admin account (used by `npm run prisma:seed`) -----------------
# There is no other way to create an admin: public registration always makes a
# CUSTOMER. Use a long, unique password - this account controls everything.
SEED_ADMIN_EMAIL=admin@carrental.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="System Administrator"
# COOKIE_DOMAIN=.example.com

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300


# Public base URL of this API. Used to build image URLs; must be the real
# domain in production.
PUBLIC_API_URL=http://localhost:4000

# --- File storage (Phase 5 onwards) --------------------------------------
# STORAGE_DRIVER: local | s3 | cloudinary
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=10

# S3 (only when STORAGE_DRIVER=s3)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudinary (only when STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Phase 7) --------------------------------------------------
# Provider is chosen by the client. Left blank until confirmed.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
PAYMENT_RETURN_URL=http://localhost:5173/account/bookings

# --- Notifications --------------------------------------------------------
# `log`  composes and records every message but sends nothing. Development
#        only - it refuses to boot in production.
# `smtp` actually sends email. SMTP is the protocol, not a supplier: Gmail,
#        Microsoft 365, Resend, Brevo, SES and the client's own mail server
#        all speak it, so switching provider is a hostname change, not a code
#        change. The client's choice (BRD 51) is made in the four lines below.
NOTIFICATION_DRIVER=log
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_FROM_NAME=
PUBLIC_SITE_URL=http://localhost:5173

# Required when NOTIFICATION_DRIVER=smtp. Port 465 means implicit TLS;
# 587 (the usual choice) starts plain and upgrades via STARTTLS.
# Gmail needs an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# --- Proxy ----------------------------------------------------------------
# How many reverse proxies sit in front of the API. 0 = none.
TRUST_PROXY_HOPS=0

# --- Docker compose ----------------------------------------------------------
# Used by docker-compose.yml only. The API reads DATABASE_URL, which compose
# assembles from these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=car_rental
APP_NAME="UAE Car Rental"
