// ---------------------------------------------------------------------------
// Prisma schema — UAE Car Rental System
// ---------------------------------------------------------------------------
// This file is the single source of truth for the database. You change this
// file, then run `npm run prisma:migrate` to generate SQL and apply it.
//
// PHASE 1 SCOPE: only the plumbing plus `SystemSetting`.
// Models are added phase by phase (see docs/database.md for the full plan) so
// that every table arrives together with the code that uses it.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Grouping for admin-editable settings, so the Admin UI can render them
/// as tabs without hardcoding a list of keys.
enum SettingCategory {
  COMPANY
  RENTAL_POLICY
  PRICING
  DOCUMENTS
  PAYMENT
  NOTIFICATION
  LEGAL
  SYSTEM
}

/// Type hint for rendering + parsing a setting value in the Admin UI.
enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  DATE
}

/// Admin-configurable settings.
///
/// The BRD repeatedly says values like VAT rate, deposit amount, cancellation
/// window, minimum rental age and document requirements are "to be provided by
/// the client". Rather than hardcode placeholder numbers we would later have to
/// hunt down, every such value lives here and is editable from the Admin
/// Dashboard. This table exists from day one because later modules (pricing,
/// cancellation, deposits) will read from it.
model SystemSetting {
  id          String           @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. "pricing.vat_percentage".
  key         String           @unique
  /// Value stored as text; `valueType` says how to parse it.
  value       String
  valueType   SettingValueType @default(STRING)
  category    SettingCategory  @default(SYSTEM)
  /// Human label shown in the Admin UI.
  label       String
  description String?
  /// `false` = admin-editable. `true` = internal, hidden from the settings UI.
  isSystem    Boolean          @default(false)
  /// Secrets (API keys) are never returned by the public settings endpoint.
  isSecret    Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

// ===========================================================================
// PHASE 2 - Identity, access control and audit
// ===========================================================================

/// The three roles from the BRD. An enum rather than a roles table: there are
/// exactly three, they are fixed, and a join buys us nothing.
enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  /// Set by an admin. Blocks login but preserves the account's rental history.
  SUSPENDED
  /// Self-service close. Kept because bookings and invoices reference the user.
  DEACTIVATED
}

/// Login identity for all three roles.
///
/// One table, not three, because authentication is identical for everyone -
/// only authorization differs. Role-specific data lives elsewhere: the richer
/// customer profile (licence details, nationality, date of birth) arrives in
/// Phase 5 as a `customers` row linked 1:1 to this one.
///
/// This table NEVER stores a password. Only a bcrypt hash.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  /// bcrypt hash. Never selected into any API response - see `toPublicUser`.
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)

  fullName String
  /// E.164 format, e.g. +971501234567. Optional until Phase 5 requires it.
  phone    String?
  /// ISO 3166-1 alpha-2, e.g. AE. The BRD collects country at registration.
  country  String?

  /// Set when the email is verified. Null = unverified. The verification flow
  /// itself (and the optional OTP login from BRD 11) is a later phase; the
  /// column exists now so we never have to migrate the table again for it.
  emailVerifiedAt DateTime?

  // --- Brute-force protection -------------------------------------------
  /// Reset to 0 on any successful login.
  failedLoginAttempts Int       @default(0)
  /// While in the future, login is refused even with the correct password.
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  /// Soft delete. A user with bookings and invoices must never be hard-deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  bookings               Booking[]
  customer               Customer?
  reviewedDocuments      CustomerDocument[]     @relation("DocumentReviewer")
  cancelledBookings      Booking[]              @relation("BookingCanceller")
  bookingStatusChanges   BookingStatusHistory[] @relation("BookingStatusChanger")
  initiatedRefunds       Refund[]               @relation("RefundInitiator")
  depositTransactions    DepositTransaction[]   @relation("DepositTransactionCreator")
  rentalsHandedOver      Rental[]               @relation("RentalHandover")
  rentalsReceived        Rental[]               @relation("RentalReceipt")
  inspectionsCarriedOut  VehicleInspection[]    @relation("InspectionStaff")
  extensionsReviewed     BookingExtension[]     @relation("ExtensionReviewer")
  chargesCreated         AdditionalCharge[]     @relation("ChargeCreator")
  damagesReported        Damage[]               @relation("DamageReporter")
  damagesApproved        Damage[]               @relation("DamageApprover")
  finesRecorded          TrafficFine[]          @relation("FineRecorder")
  tollsRecorded          TollCharge[]           @relation("TollRecorder")
  maintenanceCreated     MaintenanceRecord[]    @relation("MaintenanceCreator")
  vehicleDocsUploaded    VehicleDocument[]      @relation("VehicleDocumentUploader")
  invoices               Invoice[]              @relation("InvoiceCustomer")
  invoicesIssued         Invoice[]              @relation("InvoiceIssuer")
  couponsCreated         Coupon[]               @relation("CouponCreator")
  couponRedemptions      CouponRedemption[]     @relation("CouponRedeemer")
  notifications          Notification[]         @relation("NotificationRecipient")
  legalDocumentsAuthored LegalDocument[]        @relation("LegalDocumentAuthor")

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// One row per issued refresh token.
///
/// Why store them at all, when a JWT is self-validating? Because a stateless
/// token cannot be revoked. This table is what makes "log out everywhere" and
/// "suspend this account now" actually work.
///
/// We store a SHA-256 hash of the token, not the token. If this table leaks,
/// the hashes cannot be replayed as tokens.
model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the raw token. Unique so a lookup is a single index hit.
  tokenHash String   @unique
  expiresAt DateTime

  /// Set when the token is used (rotation) or the user logs out.
  revokedAt    DateTime?
  /// Set on rotation: the token that replaced this one. Lets us detect reuse -
  /// if a REVOKED token is presented again, it was stolen, and we revoke the
  /// user's entire token family.
  replacedById String?   @db.Uuid

  /// Captured for the audit trail and for "your account was accessed from...".
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Append-only record of security- and business-significant actions.
///
/// Required by BRD 46 ("activity/audit logs"). Deliberately denormalised:
/// `actorEmail` and `entityType` are copied in as text so the log still reads
/// correctly after the referenced user or vehicle is deleted.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Null for anonymous actions such as a failed login on an unknown email.
  actorId    String? @db.Uuid
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot, so the entry survives the actor being deleted.
  actorEmail String?
  actorRole  Role?

  /// e.g. "auth.login.success", "user.role.changed", "booking.cancelled".
  action     String
  /// e.g. "User", "Vehicle", "Booking".
  entityType String?
  entityId   String?

  /// Extra context: which fields changed, why a login failed. Never secrets.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===========================================================================
// PHASE 3 - Fleet: categories, vehicles, images, features, locations
// ===========================================================================

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  UNDER_INSPECTION
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum Transmission {
  AUTOMATIC
  MANUAL
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

/// Where an image sits on the vehicle. BRD 41 lists the exterior and interior
/// shots the client expects; typing them lets the customer gallery order shots
/// predictably instead of relying on upload order.
enum VehicleImageType {
  EXTERIOR_FRONT
  EXTERIOR_REAR
  EXTERIOR_LEFT
  EXTERIOR_RIGHT
  INTERIOR_DASHBOARD
  INTERIOR_FRONT
  INTERIOR_REAR
  INTERIOR_SEATS
  OTHER
}

enum LocationType {
  OFFICE
  AIRPORT
  HOTEL
  DELIVERY_AREA
}

/// Economy, Sedan, SUV, Luxury... BRD 8 says the real list comes from the
/// client, so this is a table the admin manages, not a hardcoded enum.
model VehicleCategory {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @unique
  /// URL-friendly key used by the customer site, e.g. "suv".
  slug         String  @unique
  description  String?
  /// Controls the order categories appear on the customer site.
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicles     Vehicle[]
  pricingRules PricingRule[]
  coupons      Coupon[]

  @@index([isActive])
  @@map("vehicle_categories")
}

/// Bluetooth, GPS, Apple CarPlay... (BRD 9). A lookup table rather than a text
/// column on the vehicle, so the customer site can offer "filter by feature"
/// without matching on free text.
model VehicleFeature {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  slug     String  @unique
  /// Optional icon key for the UI, e.g. "bluetooth".
  icon     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles VehicleFeatureOnVehicle[]

  @@map("vehicle_features")
}

/// Explicit many-to-many join. Prisma could manage an implicit relation table,
/// but an explicit one lets us add columns later (e.g. "included" vs "optional
/// extra") without a painful migration.
model VehicleFeatureOnVehicle {
  vehicleId String @db.Uuid
  featureId String @db.Uuid

  vehicle Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  feature VehicleFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([vehicleId, featureId])
  @@index([featureId])
  @@map("vehicle_features_on_vehicles")
}

/// A single physical car in the fleet.
///
/// Money is Decimal(10,2), never Float: floating point cannot represent
/// AED 0.10 exactly, and a rounding error in a 30-day rental total is a real
/// customer dispute.
///
/// `status` here is the vehicle's OWN state (in the workshop, retired from the
/// fleet). It is NOT "is this car free next Tuesday" - that is derived from
/// bookings in Phase 4. Conflating the two is how double bookings happen.
model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  brand              String
  model              String
  year               Int
  variant            String?
  /// UAE plate. Unique across the fleet - BRD 41 requires it.
  registrationNumber String  @unique

  categoryId String          @db.Uuid
  category   VehicleCategory @relation(fields: [categoryId], references: [id])

  seats        Int
  doors        Int          @default(4)
  transmission Transmission
  fuelType     FuelType
  color        String?

  dailyPrice         Decimal  @db.Decimal(10, 2)
  weeklyPrice        Decimal? @db.Decimal(10, 2)
  monthlyPrice       Decimal? @db.Decimal(10, 2)
  securityDeposit    Decimal  @db.Decimal(10, 2)
  /// Kilometres included per day. Null = unlimited.
  mileageLimitPerDay Int?
  /// Charge per km over the allowance.
  extraMileageCharge Decimal? @db.Decimal(10, 2)

  status         VehicleStatus @default(AVAILABLE)
  /// Odometer reading, updated at each return (Phase 8).
  currentMileage Int           @default(0)
  locationId     String?       @db.Uuid
  location       Location?     @relation(fields: [locationId], references: [id])

  /// Shown in the "Featured cars" section of the home page (BRD 5).
  isFeatured  Boolean @default(false)
  /// Hidden from the customer site without being deleted.
  isPublished Boolean @default(true)

  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: a vehicle with rental history must never be hard-deleted.
  deletedAt DateTime?

  images             VehicleImage[]
  features           VehicleFeatureOnVehicle[]
  bookings           Booking[]
  pricingRules       PricingRule[]
  damages            Damage[]
  trafficFines       TrafficFine[]
  tollCharges        TollCharge[]
  maintenanceRecords MaintenanceRecord[]
  insuranceRecords   InsuranceRecord[]
  documents          VehicleDocument[]
  coupons            Coupon[]

  // Indexes chosen for the queries the customer site actually runs: browse by
  // category, filter by status, and (Phase 4) the availability lookup.
  @@index([categoryId])
  @@index([status])
  @@index([isPublished, deletedAt])
  @@index([locationId])
  @@map("vehicles")
}

model VehicleImage {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// Opaque key from the storage provider (local path, S3 key, Cloudinary id).
  /// NOT a URL: the URL is built at read time, so switching provider later does
  /// not mean rewriting every row.
  storageKey String
  type       VehicleImageType @default(OTHER)
  /// Accessibility text; defaulted from the vehicle name when left blank.
  altText    String?
  /// Exactly one image per vehicle is primary - the card thumbnail.
  isPrimary  Boolean          @default(false)
  sortOrder  Int              @default(0)
  sizeBytes  Int?
  mimeType   String?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@map("vehicle_images")
}

/// Rental offices, airport counters, hotels and delivery areas (BRD 38).
model Location {
  id   String       @id @default(uuid()) @db.Uuid
  name String
  slug String       @unique
  type LocationType @default(OFFICE)

  address String?
  emirate String?
  phone   String?
  email   String?

  /// Opening hours as JSON, e.g.
  /// { "mon": { "open": "08:00", "close": "20:00" }, "sun": null }
  /// JSON rather than seven columns because the client has not confirmed the
  /// shape, and BRD 38 only says "working hours".
  workingHours Json?

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  /// Fee for delivering a vehicle here. 0 = free.
  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)
  isPickupPoint  Boolean @default(true)
  isDropoffPoint Boolean @default(true)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicles        Vehicle[]
  pickupBookings  Booking[] @relation("BookingPickupLocation")
  dropoffBookings Booking[] @relation("BookingDropoffLocation")

  @@index([type])
  @@index([isActive])
  @@map("locations")
}

// ===========================================================================
// PHASE 4 - Availability and pricing
// ===========================================================================

/// The booking lifecycle from BRD 21.
///
/// Which of these BLOCK a vehicle is the single most important decision in the
/// availability engine - see `BLOCKING_STATUSES` in the availability module.
enum BookingStatus {
  /// Created but not yet paid. Holds the vehicle only until `holdExpiresAt`.
  PENDING
  PAYMENT_PENDING
  DOCUMENT_VERIFICATION
  CONFIRMED
  READY_FOR_PICKUP
  ACTIVE
  EXTENSION_REQUESTED
  RETURN_PENDING
  RETURNED
  COMPLETED
  CANCELLED
}

/// How an add-on is charged (BRD 17).
enum ServiceChargeType {
  /// Charged once for the whole rental, e.g. delivery.
  PER_BOOKING
  /// Charged for each rental day, e.g. child seat.
  PER_DAY
}

/// What kind of rate adjustment a rule makes (BRD 16).
enum PricingRuleType {
  /// Applies on specific weekdays, e.g. Fri/Sat weekend surcharge.
  WEEKEND
  /// Applies between two dates, e.g. peak season.
  SEASONAL
  /// Percentage off for rentals at or over a minimum number of days.
  LONG_TERM_DISCOUNT
}

/// A booking.
///
/// PHASE 4 SCOPE: only the columns the availability engine needs, plus the
/// price snapshot. The full lifecycle - services, coupons, documents, payment
/// links - arrives in Phase 6. The table exists now because an availability
/// engine with nothing to collide against cannot be tested, and BRD 34 makes
/// overlap the headline acceptance criterion.
model Booking {
  id            String @id @default(uuid()) @db.Uuid
  /// Human-facing reference, e.g. "BK-2026-00042". Shown on the invoice.
  bookingNumber String @unique

  vehicleId  String  @db.Uuid
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  customerId String  @db.Uuid
  customer   User    @relation(fields: [customerId], references: [id])

  pickupLocationId  String?   @db.Uuid
  pickupLocation    Location? @relation("BookingPickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocationId String?   @db.Uuid
  dropoffLocation   Location? @relation("BookingDropoffLocation", fields: [dropoffLocationId], references: [id])

  /// The rental window.
  ///
  /// @db.Timestamptz is explicit and load-bearing. Prisma's DateTime defaults
  /// to `timestamp WITHOUT time zone`, which would store "10:00" with no record
  /// of WHICH 10:00 - a real hazard for a rental business whose staff, servers
  /// and customers may sit in different zones. It is also required by the
  /// exclusion constraint below: tstzrange() is only IMMUTABLE (and therefore
  /// indexable) over timestamptz columns.
  pickupAt DateTime @db.Timestamptz(3)
  returnAt DateTime @db.Timestamptz(3)

  status        BookingStatus @default(PENDING)
  /// While in the future, a PENDING booking holds the vehicle. Past it, the
  /// hold lapses and the car becomes bookable again - so an abandoned checkout
  /// cannot take a vehicle off sale indefinitely.
  holdExpiresAt DateTime?     @db.Timestamptz(3)

  // --- Price snapshot ---------------------------------------------------
  // Copied from the pricing engine at booking time, NOT looked up later. If
  // the admin raises the daily rate next month, last month's invoice must not
  // silently change.
  rentalDays       Int
  vehicleSubtotal  Decimal @db.Decimal(10, 2)
  servicesSubtotal Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee      Decimal @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal @default(0) @db.Decimal(10, 2)
  /// The promo code applied, as typed. A snapshot: the coupon may be renamed
  /// or withdrawn later, and this booking's paperwork should still say what
  /// the customer actually used.
  couponCode       String?
  taxAmount        Decimal @default(0) @db.Decimal(10, 2)
  /// Rental total EXCLUDING the deposit.
  totalAmount      Decimal @db.Decimal(10, 2)
  /// Held separately: a deposit is refundable and is not revenue.
  securityDeposit  Decimal @default(0) @db.Decimal(10, 2)
  currency         String  @default("AED")

  // --- Cancellation (BRD 31) -------------------------------------------
  cancelledAt        DateTime?
  cancelledById      String?   @db.Uuid
  cancelledBy        User?     @relation("BookingCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?
  /// Fee retained under the cancellation policy. Computed at cancel time from
  /// settings, then frozen - changing the policy must not rewrite history.
  cancellationFee    Decimal   @default(0) @db.Decimal(10, 2)
  /// What the customer is owed back. Actually refunded in Phase 7.
  refundDueAmount    Decimal   @default(0) @db.Decimal(10, 2)

  /// Free text from the customer at checkout, and internal staff notes.
  customerNotes String?
  staffNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services          BookingService[]
  statusHistory     BookingStatusHistory[]
  payments          Payment[]
  /// Named `deposit`, not `securityDeposit`: that name is already taken by the
  /// Decimal snapshot column above. The column is the AGREED amount; this
  /// relation is the record of what was actually held and settled.
  deposit           SecurityDeposit?
  rental            Rental?
  bookingExtensions BookingExtension[]
  additionalCharges AdditionalCharge[]
  damages           Damage[]
  trafficFines      TrafficFine[]
  tollCharges       TollCharge[]
  invoices          Invoice[]
  couponRedemption  CouponRedemption?
  agreements        BookingAgreement[]

  @@index([vehicleId, pickupAt, returnAt])
  @@index([customerId])
  @@index([status])
  @@index([pickupAt])
  /// The bookings report asks "how much did we sell in March", which is a
  /// createdAt range - a different question from pickupAt, and one the
  /// pickupAt index cannot answer.
  @@index([createdAt])
  @@map("bookings")
}

/// Optional extras a customer can add to a booking (BRD 17).
///
/// A table, not an enum: BRD 17 says "the client will provide the available
/// services and prices", so both the list and the amounts must be editable
/// from the Admin Dashboard without a deployment.
model AdditionalService {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?

  price       Decimal           @db.Decimal(10, 2)
  chargeType  ServiceChargeType @default(PER_BOOKING)
  /// Cap on how many of this service one booking may take, e.g. 3 child seats.
  maxQuantity Int               @default(1)

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookingServices BookingService[]

  @@index([isActive])
  @@map("additional_services")
}

/// Rate adjustments layered on top of a vehicle's base price (BRD 16).
///
/// Rules are data, not code, so the admin can add a Ramadan rate or a summer
/// discount without a developer. `vehicleId` and `categoryId` are both optional:
/// null on both means the rule applies fleet-wide.
model PricingRule {
  id   String          @id @default(uuid()) @db.Uuid
  name String
  type PricingRuleType

  /// Narrow the rule to one vehicle, or one category, or neither (= all).
  vehicleId  String?          @db.Uuid
  vehicle    Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  categoryId String?          @db.Uuid
  category   VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// SEASONAL: the date window the rule covers.
  startDate DateTime?
  endDate   DateTime?

  /// WEEKEND: ISO weekdays the rule applies to (1 = Monday ... 7 = Sunday).
  /// The UAE weekend is Sat/Sun in most emirates but the client confirms it,
  /// so it is stored rather than hardcoded.
  weekdays Int[] @default([])

  /// LONG_TERM_DISCOUNT: minimum rental length before the discount applies.
  minDays Int?

  /// Percentage change. Positive = surcharge, negative = discount.
  /// e.g. 20 = +20% weekend rate; -15 = 15% off long rentals.
  adjustmentPercentage Decimal @db.Decimal(5, 2)

  /// Higher priority wins when two rules of the same type overlap.
  priority Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type, isActive])
  @@index([vehicleId])
  @@index([categoryId])
  @@map("pricing_rules")
}

// ===========================================================================
// PHASE 5 - Customers and their documents
// ===========================================================================

/// Drives WHICH documents a customer must provide (BRD 12).
///
/// The BRD lists different requirements for UAE residents (Emirates ID + UAE
/// licence) and visitors (passport + visa + IDP). The exact list is
/// client-approved and lives in system_settings, but the two-way split is
/// structural, so it is an enum.
enum ResidencyStatus {
  UAE_RESIDENT
  VISITOR
}

/// Document kinds from BRD 12.
enum DocumentType {
  EMIRATES_ID
  UAE_DRIVING_LICENCE
  PASSPORT
  VISA
  /// Home-country licence, for visitors.
  DRIVING_LICENCE
  INTERNATIONAL_DRIVING_PERMIT
  OTHER
}

/// BRD 13 names exactly these four.
enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  /// Set when the expiry date passes. An approved-but-expired licence is not
  /// valid, and must not silently keep counting as approved.
  EXPIRED
}

/// Rental-specific profile, one row per customer (BRD 22 "My Profile").
///
/// Separate from `users` because that table is pure identity - it serves
/// admins and staff too, and none of this applies to them. Splitting also
/// keeps the sensitive personal data in one table that can be encrypted at
/// rest or access-audited independently.
model Customer {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Decides which documents are required. Null until the customer says.
  residencyStatus ResidencyStatus?

  dateOfBirth DateTime? @db.Date
  /// ISO 3166-1 alpha-2.
  nationality String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  emirate      String?
  country      String?

  emergencyContactName  String?
  emergencyContactPhone String?

  /// Licence details, captured once and checked against the uploaded document.
  licenceNumber         String?
  licenceIssuingCountry String?
  licenceIssueDate      DateTime? @db.Date
  licenceExpiryDate     DateTime? @db.Date

  /// Cached roll-up of document state, so the admin list and the booking flow
  /// do not have to re-derive it from every document on every read. Recomputed
  /// by the service whenever a document changes - never edited by hand.
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents CustomerDocument[]

  @@index([isVerified])
  @@map("customers")
}

/// An uploaded identity document (BRD 12 and 13).
///
/// SECURITY: `storageKey` points into the storage provider's PRIVATE area.
/// There is deliberately no URL column and no public route - the file is only
/// ever streamed through an authorised endpoint that checks who is asking.
/// BRD 12: "Do not expose private documents through public URLs."
model CustomerDocument {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type   DocumentType
  status DocumentStatus @default(PENDING)

  /// Private storage key. NOT a URL.
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int

  /// Details the customer enters and staff verify against the image.
  documentNumber String?
  issuingCountry String?
  issueDate      DateTime? @db.Date
  expiryDate     DateTime? @db.Date

  // --- Review trail (BRD 13) -------------------------------------------
  reviewedById    String?   @db.Uuid
  reviewedBy      User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  /// Required when rejecting: BRD 13 says the customer must be told why so
  /// they can upload a corrected document.
  rejectionReason String?

  /// Set when a re-upload replaces this document. The old row is KEPT - a
  /// rejected passport is part of the audit trail and must not vanish.
  supersededAt   DateTime?
  supersededById String?   @db.Uuid

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId, status])
  @@index([status])
  @@index([expiryDate])
  @@map("customer_documents")
}

// ===========================================================================
// PHASE 6 - Booking lifecycle
// ===========================================================================

/// Add-ons attached to a booking (BRD 17).
///
/// The price is COPIED here, not looked up through the relation. If the admin
/// raises the child-seat price next month, an invoice issued last month must
/// still show what the customer actually agreed to pay.
model BookingService {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  serviceId String            @db.Uuid
  service   AdditionalService @relation(fields: [serviceId], references: [id])

  /// Snapshot of the service name, so the line reads correctly even if the
  /// service is later renamed or deactivated.
  name       String
  quantity   Int
  /// Unit price AT THE TIME OF BOOKING.
  unitPrice  Decimal           @db.Decimal(10, 2)
  chargeType ServiceChargeType
  /// quantity x unitPrice x (rentalDays for PER_DAY, else 1).
  lineTotal  Decimal           @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@map("booking_services")
}

/// Every status change, append-only.
///
/// A booking's `status` column says where it is now; this says how it got
/// there. When a customer disputes "you cancelled my booking", this is the
/// record of who changed what, when, and why.
model BookingStatusHistory {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus BookingStatus?
  toStatus   BookingStatus

  /// Null for automatic transitions such as an expired hold.
  changedById String? @db.Uuid
  changedBy   User?   @relation("BookingStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

// ===========================================================================
// PHASE 7 - Payments, refunds and security deposits
// ===========================================================================

/// What a payment is FOR. Rental money is revenue; a deposit is a refundable
/// hold. Mixing them in one column would make the revenue report wrong.
enum PaymentType {
  RENTAL
  SECURITY_DEPOSIT
  /// Charges raised after return: damage, fines, fuel (Phase 9).
  ADDITIONAL_CHARGE
  EXTENSION
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DepositStatus {
  /// Not yet taken.
  PENDING
  HELD
  PARTIALLY_RELEASED
  RELEASED
  FORFEITED
}

/// Every movement on a deposit. Append-only.
enum DepositTransactionType {
  HOLD
  DEDUCTION
  RELEASE
}

/// What a deduction was for (BRD 20).
enum DeductionCategory {
  DAMAGE
  TRAFFIC_FINE
  TOLL
  FUEL
  CLEANING
  LATE_RETURN
  OTHER
}

/// A payment attempt.
///
/// NO CARD DATA. BRD 19 and 46 are explicit: raw card details are the payment
/// provider's problem, never ours. All we keep is the provider's own reference
/// so a transaction can be reconciled.
model Payment {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id])

  type   PaymentType
  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("AED")

  /// Which provider handled it - the client picks this (BRD 19).
  provider          String
  /// The provider's id for the transaction. Unique per provider so a repeated
  /// webhook cannot create a second payment row for the same charge.
  providerPaymentId String? @unique
  /// Reference shown to the customer / used for reconciliation.
  providerReference String?

  /// Sent to the provider so a retried create cannot double-charge.
  idempotencyKey String @unique

  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([bookingId])
  @@index([status])
  /// The revenue report's exact predicate: COMPLETED payments in a date
  /// window. `status` alone is barely selective once most payments have
  /// succeeded, so the date has to be in the index with it.
  @@index([status, paidAt])
  @@map("payments")
}

model Refund {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  amount Decimal      @db.Decimal(10, 2)
  status RefundStatus @default(PENDING)
  reason String?

  providerRefundId String? @unique

  /// Who authorised it. Null for automatic policy refunds.
  initiatedById String? @db.Uuid
  initiatedBy   User?   @relation("RefundInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  failureReason String?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  /// Paired with the payments index: the revenue report subtracts refunds
  /// over the same window.
  @@index([status, completedAt])
  @@map("refunds")
}

/// The security deposit for one booking (BRD 20).
///
/// The `amount` here is what was AGREED. What is actually outstanding is the
/// sum of the ledger below - never a number edited in place.
model SecurityDeposit {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount   Decimal       @db.Decimal(10, 2)
  currency String        @default("AED")
  status   DepositStatus @default(PENDING)

  heldAt    DateTime?
  settledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions DepositTransaction[]

  @@index([status])
  @@map("security_deposits")
}

/// Append-only ledger of deposit movements.
///
/// The balance is DERIVED by summing these rows, never stored as an editable
/// figure. When a customer disputes "you kept AED 500 of my deposit", the
/// ledger is the answer - and an append-only record cannot be quietly amended.
model DepositTransaction {
  id        String          @id @default(uuid()) @db.Uuid
  depositId String          @db.Uuid
  deposit   SecurityDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  type   DepositTransactionType
  /// Always POSITIVE. The `type` says which direction it moves.
  amount Decimal                @db.Decimal(10, 2)

  category DeductionCategory?
  reason   String?

  /// Who recorded it. Null for automatic movements.
  createdById String? @db.Uuid
  createdBy   User?   @relation("DepositTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([depositId])
  @@map("deposit_transactions")
}

/// Every webhook the provider sends us.
///
/// This table is what makes webhook handling IDEMPOTENT. Providers retry
/// aggressively - a payment webhook can arrive three times - and without a
/// record of what has been processed, a booking could be confirmed twice or a
/// refund issued twice.
model WebhookEvent {
  id       String @id @default(uuid()) @db.Uuid
  provider String
  /// The provider's own event id. UNIQUE: the second delivery is rejected by
  /// the database, not by a race-prone application check.
  eventId  String
  type     String

  /// Stored verbatim for debugging and dispute resolution.
  payload Json

  processedAt DateTime?
  /// Set when handling failed, so an operator can investigate and replay.
  error       String?

  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

// ===========================================================================
// PHASE 8 - The rental itself: pickup, inspection, extension, return
// ===========================================================================

enum RentalStatus {
  /// Vehicle handed over, rental running.
  ACTIVE
  /// Vehicle back, awaiting the return inspection to be finished.
  RETURNED
  /// Inspection done, charges settled.
  CLOSED
}

/// BRD 25 names the shots staff should take.
enum InspectionType {
  PICKUP
  RETURN
}

enum InspectionPhotoType {
  FRONT
  REAR
  LEFT_SIDE
  RIGHT_SIDE
  INTERIOR
  DASHBOARD
  ODOMETER
  DAMAGE
  OTHER
}

/// Extension requests (BRD 23).
enum ExtensionStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// Approved and the extra rental has been paid.
  PAID
}

/// Charges raised at return, before they touch the deposit (BRD 17 and 26).
enum ChargeType {
  LATE_RETURN
  EXCESS_MILEAGE
  FUEL
  CLEANING
  DAMAGE
  OTHER
}

enum ChargeStatus {
  /// Calculated, not yet applied to the deposit or invoiced.
  PENDING
  /// Taken from the security deposit.
  SETTLED_FROM_DEPOSIT
  /// Beyond the deposit; billed separately.
  INVOICED
  /// Written off by an admin.
  WAIVED
}

/// The rental itself - created when the vehicle is handed over.
///
/// Separate from `bookings` because a booking is an AGREEMENT and a rental is
/// what actually happened. They usually match; when they do not - the customer
/// collected two hours late, returned a day early, drove 800km - it is the
/// rental that records reality, and the difference is what gets charged.
model Rental {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status RentalStatus @default(ACTIVE)

  /// When the keys actually changed hands, not when they were due to.
  pickedUpAt DateTime  @db.Timestamptz(3)
  returnedAt DateTime? @db.Timestamptz(3)

  pickupMileage     Int
  returnMileage     Int?
  /// Percentage, 0-100. BRD 30 records fuel at both ends.
  pickupFuelPercent Int
  returnFuelPercent Int?

  /// Staff who handled each end.
  handedOverById String? @db.Uuid
  handedOverBy   User?   @relation("RentalHandover", fields: [handedOverById], references: [id], onDelete: SetNull)
  receivedById   String? @db.Uuid
  receivedBy     User?   @relation("RentalReceipt", fields: [receivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections VehicleInspection[]

  @@index([status])
  @@map("rentals")
}

/// A condition record at one end of the rental (BRD 24, 25 and 26).
///
/// Two of these per rental: one at PICKUP, one at RETURN. Comparing them is
/// what turns "the customer says the scratch was already there" into an
/// answerable question rather than an argument.
model VehicleInspection {
  id       String         @id @default(uuid()) @db.Uuid
  rentalId String         @db.Uuid
  rental   Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  type     InspectionType

  mileage     Int
  fuelPercent Int

  /// Free text: dents, scratches, anything worth writing down.
  conditionNotes String?
  /// BRD 26 asks for cleaning condition at return.
  cleanliness    String?

  /// What was in the car, e.g. ["spare tyre","jack","child seat"]. JSON
  /// because BRD 24 says "accessories" without fixing a list, and the client
  /// has not confirmed one.
  accessories Json?

  /// Damage already present at pickup - the baseline the return is judged
  /// against. Recorded at BOTH ends: at return this is the NEW damage.
  damageNotes String?

  /// Staff member who carried out the inspection.
  inspectedById String? @db.Uuid
  inspectedBy   User?   @relation("InspectionStaff", fields: [inspectedById], references: [id], onDelete: SetNull)

  /// Set at pickup when staff confirmed the customer's identity (BRD 24).
  customerVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos InspectionPhoto[]

  @@unique([rentalId, type])
  @@index([rentalId])
  @@map("vehicle_inspections")
}

/// Evidence. BRD 25 lists the recommended shots.
///
/// PUBLIC storage, unlike customer documents: these are photographs of a car,
/// not of anybody's passport, and staff need to view them quickly on a phone
/// at the counter.
model InspectionPhoto {
  id           String            @id @default(uuid()) @db.Uuid
  inspectionId String            @db.Uuid
  inspection   VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  type       InspectionPhotoType @default(OTHER)
  storageKey String
  caption    String?
  sizeBytes  Int?
  mimeType   String?

  createdAt DateTime @default(now())

  @@index([inspectionId])
  @@map("inspection_photos")
}

/// A request to keep the vehicle longer (BRD 23).
model BookingExtension {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// Snapshot of the return time being extended FROM, so the history reads
  /// correctly even after the booking's own returnAt moves.
  originalReturnAt  DateTime @db.Timestamptz(3)
  requestedReturnAt DateTime @db.Timestamptz(3)

  status ExtensionStatus @default(REQUESTED)

  /// Extra billable days and what they cost, priced when the request is made.
  additionalDays   Int
  additionalAmount Decimal @db.Decimal(10, 2)
  currency         String  @default("AED")

  /// Why an extension was refused - usually because the car is booked next.
  rejectionReason String?

  reviewedById String?   @db.Uuid
  reviewedBy   User?     @relation("ExtensionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("booking_extensions")
}

/// A charge raised after the vehicle comes back (BRD 17 and 26).
///
/// Kept SEPARATE from the deposit ledger on purpose. A charge is a decision -
/// "the car came back 3 hours late, that is one extra day" - while a deposit
/// transaction is a movement of money. One charge may be settled from the
/// deposit, invoiced, or waived, and the record of the decision should survive
/// whichever happens.
model AdditionalCharge {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type   ChargeType
  status ChargeStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("AED")

  /// What the customer is told, e.g. "Returned 3h late (1 extra day)".
  description String
  /// How the figure was reached, kept for disputes.
  calculation Json?

  createdById String? @db.Uuid
  createdBy   User?   @relation("ChargeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("additional_charges")
}

// ===========================================================================
// PHASE 9 - Damages, fines, tolls, maintenance and insurance
// ===========================================================================

enum DamageType {
  SCRATCH
  DENT
  BROKEN_PART
  INTERIOR
  TYRE
  GLASS
  MECHANICAL
  OTHER
}

/// Damage moves through assessment before anyone is charged (BRD 27).
enum DamageStatus {
  /// Recorded at return, not yet costed.
  REPORTED
  /// An estimate exists, awaiting an admin decision.
  ASSESSED
  /// Approved at a definite amount; a charge can be raised.
  APPROVED
  /// Judged fair wear and tear, or the customer's account accepted.
  DISMISSED
  /// The approved amount has been charged.
  CHARGED
}

/// Fines and tolls share a lifecycle but NOT a table - see the models below.
enum ChargeRecoveryStatus {
  /// Received from the authority, not yet passed on.
  RECORDED
  /// Attributed to a specific rental and customer.
  ASSIGNED
  /// Recovered from the deposit or invoiced.
  RECOVERED
  /// Written off.
  WAIVED
  /// The customer disputes it.
  DISPUTED
}

enum MaintenanceType {
  ROUTINE_SERVICE
  REPAIR
  TYRE_CHANGE
  BODYWORK
  INSPECTION
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Vehicle paperwork with expiry dates (BRD 41).
enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  REGISTRATION_RENEWAL
  INSURANCE_RENEWAL
  MAINTENANCE_RECORD
  INSPECTION_REPORT
  OTHER
}

/// Damage found on a vehicle (BRD 27).
///
/// Deliberately NOT folded into AdditionalCharge. A charge is a settled amount;
/// damage is an assessment that starts as "there is a scratch", becomes an
/// estimate, may be argued about, and only then becomes money. Collapsing the
/// two would lose the middle - which is exactly the part that gets disputed.
model Damage {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  /// The rental it was found on. Null for damage discovered off-hire.
  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  type        DamageType
  status      DamageStatus @default(REPORTED)
  description String
  /// Where on the car, e.g. "Rear bumper, driver side".
  location    String?

  /// What we think it will cost, entered at assessment.
  estimatedAmount Decimal? @db.Decimal(10, 2)
  /// What the admin actually approved. Charging uses THIS, never the estimate.
  approvedAmount  Decimal? @db.Decimal(10, 2)
  currency        String   @default("AED")

  /// Why it was dismissed, or why the approved amount differs from the
  /// estimate. The customer may well ask.
  assessmentNotes String?

  reportedById String?   @db.Uuid
  reportedBy   User?     @relation("DamageReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  approvedById String?   @db.Uuid
  approvedBy   User?     @relation("DamageApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos DamagePhoto[]

  @@index([vehicleId])
  @@index([bookingId])
  @@index([status])
  @@map("damages")
}

model DamagePhoto {
  id       String @id @default(uuid()) @db.Uuid
  damageId String @db.Uuid
  damage   Damage @relation(fields: [damageId], references: [id], onDelete: Cascade)

  storageKey String
  caption    String?
  sizeBytes  Int?
  mimeType   String?

  createdAt DateTime @default(now())

  @@index([damageId])
  @@map("damage_photos")
}

/// A traffic fine (BRD 28).
///
/// Fines and tolls get SEPARATE tables even though their lifecycles rhyme.
/// A fine has an authority-issued number, a violation, a contest window and a
/// driver who may deny it; a toll is an automatic gate reading. They are
/// disputed differently, reported differently, and one table with a `type`
/// column would end up half-empty in both directions.
model TrafficFine {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  /// The rental it fell in, once matched by date. Null until assigned.
  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// The authority's own reference. Unique: the same fine must not be entered
  /// twice and charged twice.
  fineNumber  String   @unique
  /// When the offence happened - this is what matches it to a rental.
  violationAt DateTime @db.Timestamptz(3)
  violation   String?
  location    String?

  amount     Decimal @db.Decimal(10, 2)
  /// The company's own handling fee, kept separate from the authority's
  /// amount so an invoice can show both honestly (BRD 28).
  serviceFee Decimal @default(0) @db.Decimal(10, 2)
  currency   String  @default("AED")

  status ChargeRecoveryStatus @default(RECORDED)
  notes  String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation("FineRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([bookingId])
  @@index([status])
  @@index([violationAt])
  @@map("traffic_fines")
}

/// A toll / Salik crossing (BRD 29).
model TollCharge {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// When the gate was crossed - matches the charge to a rental.
  crossedAt DateTime @db.Timestamptz(3)
  /// Gate name, e.g. "Al Barsha".
  gate      String?
  /// The operator's transaction reference, where one exists.
  reference String?

  amount     Decimal @db.Decimal(10, 2)
  serviceFee Decimal @default(0) @db.Decimal(10, 2)
  currency   String  @default("AED")

  status ChargeRecoveryStatus @default(RECORDED)
  notes  String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation("TollRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([bookingId])
  @@index([status])
  @@index([crossedAt])
  @@map("toll_charges")
}

/// A service or repair (BRD 39).
///
/// The DATE RANGE is the important part. BRD 39 says a vehicle "can
/// automatically be marked unavailable while under maintenance", and a date
/// range says that far better than a status flag: a car booked in for a
/// service on the 20th is available on the 10th, and the availability engine
/// can see that. A flag can only say "off the road", indefinitely.
model MaintenanceRecord {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type   MaintenanceType
  status MaintenanceStatus @default(SCHEDULED)

  /// The window the vehicle is off the road. Blocks availability.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  description String
  /// Where the work is being done.
  provider    String?
  /// Odometer at the time of service.
  mileage     Int?
  cost        Decimal? @db.Decimal(10, 2)
  currency    String   @default("AED")

  /// Next service due, by date and/or odometer (BRD 39).
  nextServiceAt      DateTime?
  nextServiceMileage Int?

  notes String?

  createdById String? @db.Uuid
  createdBy   User?   @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The index the availability engine uses to find overlapping windows.
  @@index([vehicleId, startsAt, endsAt])
  @@index([status])
  @@map("maintenance_records")
}

/// An insurance policy on a vehicle (BRD 40).
model InsuranceRecord {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  provider     String
  policyNumber String
  /// Comprehensive, third-party, and so on. Free text: the client has not
  /// confirmed a list.
  coverType    String?

  startDate  DateTime @db.Date
  expiryDate DateTime @db.Date

  premium  Decimal? @db.Decimal(10, 2)
  currency String   @default("AED")

  /// Set when a newer policy supersedes this one, so the history survives.
  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Expiry reminders scan this (BRD 41).
  @@index([vehicleId, isActive])
  @@index([expiryDate])
  @@map("insurance_records")
}

/// Paperwork attached to a vehicle (BRD 41).
///
/// PRIVATE storage, like customer documents. A registration card carries the
/// owner's details and a chassis number; it is not marketing material.
model VehicleDocument {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type VehicleDocumentType

  /// Private storage key. NOT a URL - reached only through an authorised route.
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int

  documentNumber String?
  issueDate      DateTime? @db.Date
  /// Drives the expiry reminders. Null for documents that do not expire.
  expiryDate     DateTime? @db.Date

  notes String?

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation("VehicleDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([expiryDate])
  @@map("vehicle_documents")
}

// ===========================================================================
// PHASE 10 - Output: invoices, notifications, coupons, legal documents
// ===========================================================================

/// Gapless counters for documents that must be numbered.
///
/// Booking numbers can get away with `count() + 1` because they are generated
/// inside a SERIALIZABLE transaction. A tax invoice cannot: it needs a unique,
/// never-reused number even when two staff issue invoices in the same
/// millisecond under READ COMMITTED. An atomic `increment` on one row gives
/// exactly that, and the row lock is held for microseconds.
model NumberSequence {
  /// e.g. "invoice", "credit_note".
  key       String   @id
  year      Int
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("number_sequences")
}

enum InvoiceType {
  INVOICE
  /// A correction. Invoices are never edited or deleted (BRD 28) - a mistake
  /// is fixed by issuing a credit note that references the original.
  CREDIT_NOTE
}

enum InvoiceStatus {
  ISSUED
  PAID
  /// Fully reversed by a credit note.
  CANCELLED
}

/// A tax invoice (BRD 28).
///
/// Everything here is a SNAPSHOT taken at the moment of issue: the company's
/// details, the customer's details, the tax rate, every line. That is the whole
/// point of the table. Regenerating an invoice from the live booking would mean
/// last year's invoice silently changes when someone edits a price or the
/// company address - which for a tax document is not a bug, it is a
/// falsification.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  type          InvoiceType   @default(INVOICE)
  status        InvoiceStatus @default(ISSUED)

  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id])

  customerId String @db.Uuid
  customer   User   @relation("InvoiceCustomer", fields: [customerId], references: [id])

  /// --- Seller snapshot. From settings AT ISSUE TIME, not read live. -------
  /// Null where the client has not supplied the value yet; the invoice then
  /// carries a visible gap rather than an invented company name or TRN.
  companyName    String?
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  /// UAE Tax Registration Number. Legally required on a tax invoice, and
  /// exactly the sort of value BRD 51 says comes from the client.
  companyTrn     String?

  /// --- Buyer snapshot ----------------------------------------------------
  customerName    String
  customerEmail   String
  customerPhone   String?
  customerAddress String?

  /// --- Money. All snapshotted. -------------------------------------------
  subtotal      Decimal  @db.Decimal(10, 2)
  discountTotal Decimal  @default(0) @db.Decimal(10, 2)
  taxableAmount Decimal  @db.Decimal(10, 2)
  /// The rate actually applied, recorded as a number so the invoice can state
  /// it. Null means VAT was not configured when this was issued.
  taxPercentage Decimal? @db.Decimal(5, 2)
  taxTotal      Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  currency      String   @default("AED")

  /// Credit notes point at what they correct.
  correctsId String?   @db.Uuid
  corrects   Invoice?  @relation("InvoiceCorrection", fields: [correctsId], references: [id])
  creditedBy Invoice[] @relation("InvoiceCorrection")

  reason String?
  notes  String?

  issuedAt   DateTime @default(now())
  issuedById String?  @db.Uuid
  issuedBy   User?    @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([customerId])
  @@index([issuedAt])
  @@map("invoices")
}

/// One line on an invoice. Written once, with the invoice, and never updated.
model InvoiceLineItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  sortOrder   Int     @default(0)
  description String
  detail      String?

  /// Decimal, not Int: a per-day service on a 1.5-day rental is a real case.
  quantity  Decimal @default(1) @db.Decimal(10, 2)
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  /// Deposits and other non-supply lines sit outside the tax base.
  isTaxable Boolean @default(true)

  @@index([invoiceId, sortOrder])
  @@map("invoice_line_items")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// A promotional code (BRD 19).
///
/// Every constraint lives here rather than in a marketing spreadsheet, because
/// the backend has to be able to refuse a code on its own: the browser sending
/// "discount: 500" is a suggestion, not a discount.
model Coupon {
  id          String  @id @default(uuid()) @db.Uuid
  /// Stored uppercase and matched uppercase, so SUMMER25 and summer25 are the
  /// same code rather than two.
  code        String  @unique
  description String?

  discountType DiscountType
  /// A percentage (0-100) or a fixed amount, depending on discountType.
  value        Decimal      @db.Decimal(10, 2)
  /// Caps a percentage discount. "20% off, up to AED 200" is a normal offer,
  /// and without this a 20% code on a Porsche is an expensive surprise.
  maxDiscount  Decimal?     @db.Decimal(10, 2)

  /// Qualification rules. All optional; all enforced server-side.
  minRentalAmount Decimal? @db.Decimal(10, 2)
  minRentalDays   Int?

  validFrom  DateTime
  validUntil DateTime

  /// Null = unlimited.
  usageLimit       Int?
  perCustomerLimit Int?
  /// Denormalised counter, incremented in the same transaction as the
  /// redemption row. Cheap to read on the admin list; the redemption rows
  /// remain the source of truth.
  timesUsed        Int  @default(0)

  /// Scope. Both null = the whole fleet.
  categoryId String?          @db.Uuid
  category   VehicleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vehicleId  String?          @db.Uuid
  vehicle    Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  createdById String? @db.Uuid
  createdBy   User?   @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)

  redemptions CouponRedemption[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive, validFrom, validUntil])
  @@map("coupons")
}

/// One use of a coupon on one booking.
///
/// The UNIQUE on bookingId is what stops a code being applied twice to the
/// same booking, and the rows are what the per-customer limit counts. The
/// counter on Coupon is a convenience; this table is the record.
model CouponRedemption {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  customerId String @db.Uuid
  customer   User   @relation("CouponRedeemer", fields: [customerId], references: [id])

  /// What the code was actually worth on this booking, in money.
  discountAmount Decimal @db.Decimal(10, 2)
  /// The code as typed, kept even if the coupon is later renamed or deleted.
  codeUsed       String

  redeemedAt DateTime @default(now())

  @@index([couponId, customerId])
  @@map("coupon_redemptions")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  /// Deliberately not sent - no provider configured, or no address on file.
  /// Distinct from FAILED, which means we tried and it did not work.
  SKIPPED
}

/// The outbound message log (BRD 42-44).
///
/// Every notification the system decides to send is written here FIRST, then
/// handed to a provider. That ordering matters: if the provider call throws,
/// there is still a row saying what we meant to send and why it did not go.
/// "Did the customer get the confirmation?" is then a query, not a guess.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  channel     NotificationChannel
  /// Which template produced this, e.g. "booking.confirmed".
  templateKey String

  recipientId String? @db.Uuid
  recipient   User?   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  /// The address actually used, snapshotted - the customer may change their
  /// email later, and the log should still say where this one went.
  toAddress   String

  subject String?
  body    String

  status      NotificationStatus @default(PENDING)
  attempts    Int                @default(0)
  /// Which driver handled it, e.g. "log", "smtp". Null until an attempt.
  provider    String?
  /// Provider's own id, for chasing a message up with them.
  providerRef String?
  lastError   String?
  sentAt      DateTime?

  /// What this is about, so a booking's messages can be listed.
  relatedType String?
  relatedId   String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, createdAt])
  @@index([status])
  @@index([relatedType, relatedId])
  @@map("notifications")
}

/// The text of one notification, editable by the client (BRD 44).
///
/// Seeded with working English so the system is not silent out of the box, but
/// stored in the database rather than in code because wording, tone and
/// language are the client's, and changing "Dear customer" should not require
/// a deployment.
model NotificationTemplate {
  id          String              @id @default(uuid()) @db.Uuid
  key         String
  channel     NotificationChannel
  /// Unused for SMS and WhatsApp.
  subject     String?
  /// Supports {{placeholders}} filled from the trigger's data.
  body        String
  description String?
  isActive    Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One template per key per channel: the same event can legitimately have
  /// both an email and an SMS version.
  @@unique([key, channel])
  @@map("notification_templates")
}

enum LegalDocumentType {
  TERMS_AND_CONDITIONS
  PRIVACY_POLICY
  RENTAL_AGREEMENT
  CANCELLATION_POLICY
  REFUND_POLICY
}

/// Versioned legal text (BRD 45-47).
///
/// Versioned rather than editable in place, because the question that gets
/// asked in a dispute is not "what do the terms say?" but "what did the terms
/// say on the day they booked?". Publishing a new version supersedes the old
/// one; it never overwrites it.
model LegalDocument {
  id      String            @id @default(uuid()) @db.Uuid
  type    LegalDocumentType
  version Int
  title   String
  /// Markdown. Rendered by the frontend, so the client can format without HTML.
  content String

  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  effectiveFrom DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("LegalDocumentAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  agreements BookingAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, version])
  @@index([type, isPublished])
  @@map("legal_documents")
}

/// Proof of which version of which document a customer agreed to, and when.
model BookingAgreement {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  legalDocumentId String        @db.Uuid
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id])

  agreedAt  DateTime @default(now())
  ipAddress String?

  @@unique([bookingId, legalDocumentId])
  @@map("booking_agreements")
}
